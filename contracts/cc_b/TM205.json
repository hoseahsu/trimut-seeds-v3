      "native_invariants": "T,D,values1..100000;sumN<=500000 native, L2 retains aggregate500000",
      "source_evidence": [
        {
          "line": 1,
          "text": "Given an array of N numbers, a pair of numbers is called good if difference between the two numbers is strictly less than D."
        },
        {
          "line": 2,
          "text": "Find out maximum possible sum of all good disjoint pairs that can be made from these numbers."
        },
        {
          "line": 3,
          "text": "Sum of X pairs is the sum of all 2*X numbers in the pairs."
        },
        {
          "line": 15,
          "text": "Constraints"
        },
        {
          "line": 17,
          "text": "1 ≤ T, N, D, Array Elements ≤ 10^5"
        },
        {
          "line": 18,
          "text": "1 ≤ Sum of N over all test cases ≤ 5*10^5"
        },
        {
          "line": 43,
          "text": "Pair (a,b) is disjoint with pair (c,d) if and only if indices of a, b, c and d in the array are distinct."
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
