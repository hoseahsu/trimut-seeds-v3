      "native_invariants": "T1..10;N>=2;1<=K<N; coordinates1..10^9 strictly ascending by stone locations wording; source says ascending, equal positions incompatible specified exactlyK distinctforwardjumps",
      "source_evidence": [
        {
          "line": 3,
          "text": "There are N stones arranged in a straight line. In order to fulfill the task, Manu has to travel from the first stone to the last one in a very specific way. First of all, he has to do it using exactly K jumps. In a single jump, he can jump from a stone with coordinate xi to a stone with coordinate xj if and only if xi < xj. We denote the value xj - xi as the length of such a jump."
        },
        {
          "line": 5,
          "text": "Your task is to help Manu minimize the maximum length of a jump he makes in his journey, in order to reach the last stone in exactly K jumps and save the mankind. This is the answer you have to provide."
        },
        {
          "line": 15,
          "text": "Constraints:"
        },
        {
          "line": 17,
          "text": "1 ≤ T ≤ 10"
        },
        {
          "line": 18,
          "text": "2 ≤ N ≤ 10^5"
        },
        {
          "line": 19,
          "text": "1 ≤ K ≤ (N-1)"
        },
        {
          "line": 20,
          "text": "1 ≤ Coordinates of stones ≤ 10^9"
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
    }
  },
