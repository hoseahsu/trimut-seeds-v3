      "native_invariants": "n2..500;weights1..100;bookIDs1..n; repeats allowed",
      "source_evidence": [
        {
          "line": 1,
          "text": "New Year is coming, and Jaehyun decided to read many books during 2015, unlike this year. He has n books numbered by integers from 1 to n. The weight of the i-th (1 ≤ i ≤ n) book is wi."
        },
        {
          "line": 14,
          "text": "He decided to read books for m days. In the j-th (1 ≤ j ≤ m) day, he will read the book that is numbered with integer bj (1 ≤ bj ≤ n). To read the book, he has to use the process described in the paragraph above. It is possible that he decides to re-read the same book several times."
        },
        {
          "line": 20,
          "text": "The first line contains two space-separated integers n (2 ≤ n ≤ 500) and m (1 ≤ m ≤ 1000) — the number of books, and the number of days for which Jaehyun would read books."
        },
        {
          "line": 22,
          "text": "The second line contains n space-separated integers w1, w2, ..., wn (1 ≤ wi ≤ 100) — the weight of each book."
        },
        {
          "line": 24,
          "text": "The third line contains m space separated integers b1, b2, ..., bm (1 ≤ bj ≤ n) — the order of books that he would read. Note that he can read the same book more than once."
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
    }
  },
