        }
      ],
      "native_invariants": "m1..1000000;permutation1..n; swap endpoints1..n; repeated/selfpairs not prohibited",
      "source_evidence": [
        {
          "line": 5,
          "text": "Let p and q be two permutations of the numbers 1, 2, ..., n. p is lexicographically smaller than the q if a number 1 ≤ i ≤ n exists, so pk = qk for 1 ≤ k < i and pi < qi."
        },
        {
          "line": 9,
          "text": "The first line contains two integers n and m (1 ≤ n, m ≤ 10^6) — the length of the permutation p and the number of pairs of positions."
        },
        {
          "line": 11,
          "text": "The second line contains n distinct integers pi (1 ≤ pi ≤ n) — the elements of the permutation p."
        },
        {
          "line": 13,
          "text": "Each of the last m lines contains two integers (aj, bj) (1 ≤ aj, bj ≤ n) — the pairs of positions to swap. Note that you are given a positions, not the values to swap."
        },
        {
          "line": 17,
          "text": "Print the only line with n distinct integers p'i (1 ≤ p'i ≤ n) — the lexicographically maximal permutation one can get."
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
    }
  },
