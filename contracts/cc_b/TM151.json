      "native_invariants": "N>=2;A permutation1..N;B,C1..50",
      "source_evidence": [
        {
          "line": 3,
          "text": "The i-th dish (1 \\leq i \\leq N) he ate was Dish A_i."
        },
        {
          "line": 5,
          "text": "When he eats Dish i (1 \\leq i \\leq N), he gains B_i satisfaction points."
        },
        {
          "line": 7,
          "text": "Additionally, when he eats Dish i+1 just after eating Dish i (1 \\leq i \\leq N - 1), he gains C_i more satisfaction points."
        },
        {
          "line": 9,
          "text": "Find the sum of the satisfaction points he gained."
        },
        {
          "line": 11,
          "text": "Constraints"
        },
        {
          "line": 14,
          "text": "* 2 \\leq N \\leq 20"
        },
        {
          "line": 15,
          "text": "* 1 \\leq A_i \\leq N"
        },
        {
          "line": 17,
          "text": "* 1 \\leq B_i \\leq 50"
        },
        {
          "line": 18,
          "text": "* 1 \\leq C_i \\leq 50"
        },
        {
          "line": 33,
          "text": "Print the sum of the satisfaction points Takahashi gained, as an integer."
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
