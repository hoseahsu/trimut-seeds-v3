      "native_invariants": "T1..10;Wi1..10^6",
      "source_evidence": [
        {
          "line": 6,
          "text": " There is exactly one shop on each segment. Each shop has an attractiveness. If it's attractiveness is W and Chef and his girlfriend move with velocity V then if V < W girlfriend will run away into the shop and the promenade will become ruined. "
        },
        {
          "line": 25,
          "text": "Constraints"
        },
        {
          "line": 27,
          "text": "1 ≤ T ≤ 10"
        },
        {
          "line": 28,
          "text": "1 ≤ N ≤ 10^5"
        },
        {
          "line": 29,
          "text": "1 ≤ Wi ≤ 10^6"
        },
        {
          "line": 50,
          "text": " If we choose velocity 6, on the first step we have 6 ≥ 6 everything is OK, then we should decrease the velocity to 5 and on the 2nd segment we'll receive 5 ≥ 5, again OK, and so on. "
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
    }
