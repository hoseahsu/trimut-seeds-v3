      "native_invariants": "m1..200000;permutation1..n;queries1<=l<=r<=n",
      "source_evidence": [
        {
          "line": 1,
          "text": "A permutation of size n is an array of size n such that each integer from 1 to n occurs exactly once in this array. An inversion in a permutation p is a pair of indices (i, j) such that i > j and ai < aj. For example, a permutation [4, 1, 3, 2] contains 4 inversions: (2, 1), (3, 1), (4, 1), (4, 3)."
        },
        {
          "line": 9,
          "text": "The first line contains one integer n (1 ≤ n ≤ 1500) — the size of the permutation. "
        },
        {
          "line": 11,
          "text": "The second line contains n integers a1, a2, ..., an (1 ≤ ai ≤ n) — the elements of the permutation. These integers are pairwise distinct."
        },
        {
          "line": 13,
          "text": "The third line contains one integer m (1 ≤ m ≤ 2·10^5) — the number of queries to process."
        },
        {
          "line": 15,
          "text": "Then m lines follow, i-th line containing two integers li, ri (1 ≤ li ≤ ri ≤ n) denoting that i-th query is to reverse a segment [li, ri] of the permutation. All queries are performed one after another."
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
    }
  },
