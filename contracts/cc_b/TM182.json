      "native_invariants": "m1..50;bothstrictlyincreasing1..10000;atleastoneintegralratio; expandingn to10000 retains valuesrange",
      "source_evidence": [
        {
          "line": 3,
          "text": "We know that the i-th star on the pedal axle has ai (0 < a1 < a2 < ... < an) teeth, and the j-th star on the rear wheel axle has bj (0 < b1 < b2 < ... < bm) teeth. Any pair (i, j) (1 ≤ i ≤ n; 1 ≤ j ≤ m) is called a gear and sets the indexes of stars to which the chain is currently attached. Gear (i, j) has a gear ratio, equal to the value b_j / a_i."
        },
        {
          "line": 11,
          "text": "The first input line contains integer n (1 ≤ n ≤ 50) — the number of stars on the bicycle's pedal axle. The second line contains n integers a1, a2, ..., an (1 ≤ ai ≤ 10^4) in the order of strict increasing."
        },
        {
          "line": 13,
          "text": "The third input line contains integer m (1 ≤ m ≤ 50) — the number of stars on the rear wheel axle. The fourth line contains m integers b1, b2, ..., bm (1 ≤ bi ≤ 10^4) in the order of strict increasing."
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
    }
