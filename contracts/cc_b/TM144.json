      "native_axes": [
        {
          "name": "command_count",
          "upper_inclusive": 100,
          "proposed_l2_upper_inclusive": 100000
        }
      ],
      "native_invariants": "line<=100chars; valid +/- membership history;alphanumeric case-sensitive names;message lettersdigits spaces, no edge spaces, mayempty",
      "source_evidence": [
        {
          "line": 11,
          "text": "Polycarp knows that chat server sends no traffic for 'Add' and 'Remove' commands. When 'Send' command is processed, server sends l bytes to each participant of the chat, where l is the length of the message."
        },
        {
          "line": 17,
          "text": "Input file will contain not more than 100 commands, each in its own line. No line will exceed 100 characters. Formats of the commands will be the following:"
        },
        {
          "line": 19,
          "text": "  * +<name> for 'Add' command. "
        },
        {
          "line": 20,
          "text": "  * -<name> for 'Remove' command. "
        },
        {
          "line": 21,
          "text": "  * <sender_name>:<message_text> for 'Send' command. "
        },
        {
          "line": 25,
          "text": "<name> and <sender_name> is a non-empty sequence of Latin letters and digits. <message_text> can contain letters, digits and spaces, but can't start or end with a space. <message_text> can be an empty line."
        }
      ],
      "status": "contract_transcription_for_implementation;L2proposal_not_yet_validated",
      "preserve_other_native_bounds": true
    }
  },
